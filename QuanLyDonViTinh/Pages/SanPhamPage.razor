@page "/sanpham"

@using QuanLyDonViTinh.Models
@using QuanLyDonViTinh.Services
@inject SanPhamService SPService
@inject LoaiSanPhamService LSPService
@inject DonViTinhService DVTService
@inject IJSRuntime JSRuntime

<h3>Danh mục Sản Phẩm</h3>

<EditForm Model="@spDuocChon" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <InputNumber @bind-Value="spDuocChon.Ma_San_Pham" hidden />

    <div class="form-group">
        <label>Mã Sản Phẩm:</label>
        <InputText @bind-Value="spDuocChon.Ma_SP" class="form-control" MaxLength="50" />
        <ValidationMessage For="@(() => spDuocChon.Ma_SP)" />
    </div>

    <div class="form-group">
        <label>Tên Sản Phẩm:</label>
        <InputText @bind-Value="spDuocChon.Ten_San_Pham" class="form-control" MaxLength="100" />
        <ValidationMessage For="@(() => spDuocChon.Ten_San_Pham)" />
    </div>

    <div class="form-group">
        <label>Ghi chú:</label>
        <InputText @bind-Value="spDuocChon.Ghi_Chu" class="form-control" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" style="color: red;">@errorMessage</div>
    }

    <button type="submit" class="btn btn-primary">
        @(spDuocChon.Ma_San_Pham == 0 ? "Thêm mới" : "Lưu thay đổi")
    </button>

    @if (spDuocChon.Ma_San_Pham != 0)
    {
        <button type="button" class="btn btn-secondary" @onclick="HuyBoSua">Hủy bỏ</button>
    }
</EditForm>

<hr />

<h4>Danh sách hiện có</h4>
@if (danhSachSP == null)
{
    <p><em>Đang tải dữ liệu...</em></p>
}
else
{
    <table class="table" border="1" style="border-collapse: collapse; width: 80%;">
        <thead>
            <tr>
                <th>Mã SP</th>
                <th>Tên Sản Phẩm</th>
                <th>Loại SP</th>
                <th>ĐVT</th>
                <th>Ghi Chú</th>
                <th>Chức năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sp in danhSachSP)
            {
                <tr>
                    <td>@sp.Ma_SP</td>
                    <td>@sp.Ten_San_Pham</td>
                    <td>@sp.Ten_Loai_San_Pham</td>
                    <td>@sp.Ten_Don_Vi_Tinh</td>
                    <td>@sp.Ghi_Chu</td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => ChonDeSua(sp)">
                            Sửa
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => XoaSanPham(sp)">
                            Xóa
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<SanPham> danhSachSP;
    private SanPham spDuocChon = new SanPham();
    private string errorMessage;
    private IEnumerable<LoaiSanPham> loaiSanPhams;
    private IEnumerable<DonViTinh> donViTinhs;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        loaiSanPhams = await LSPService.GetDanhSach();
        donViTinhs = await DVTService.GetDanhSach();
        await LoadDanhSach();
    }

    private async Task LoadDanhSach()
    {
        danhSachSP = await SPService.GetDanhSach();
        errorMessage = null;
    }

    private void ChonDeSua(SanPham sp)
    {
        spDuocChon = new SanPham
            {
                Ma_San_Pham = sp.Ma_San_Pham,
                Ma_SP = sp.Ma_SP,
                Ten_San_Pham = sp.Ten_San_Pham,
                Loai_San_Pham_ID = sp.Loai_San_Pham_ID,
                Don_Vi_Tinh_ID = sp.Don_Vi_Tinh_ID,
                Ghi_Chu = sp.Ghi_Chu
            };
        errorMessage = null;
    }

    private void HuyBoSua()
    {
        spDuocChon = new SanPham();
        errorMessage = null;
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (spDuocChon.Ma_San_Pham == 0)
            {
                await SPService.AddSanPham(spDuocChon);
            }
            else
            {
                await SPService.UpdateSanPham(spDuocChon);
            }
            await LoadAllData();
            HuyBoSua();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task XoaSanPham(SanPham sp)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Bạn có chắc muốn xóa sản phẩm '{sp.Ten_San_Pham}' không?");

        if (confirmed)
        {
            try
            {
                await SPService.DeleteSanPham(sp.Ma_San_Pham);
                await LoadAllData(); // Tải lại toàn bộ dữ liệu
                if (spDuocChon.Ma_San_Pham == sp.Ma_San_Pham)
                {
                    HuyBoSua();
                }
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
        }
    }
}