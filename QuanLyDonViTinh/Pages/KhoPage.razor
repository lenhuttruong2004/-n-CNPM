@page "/kho"

@using QuanLyDonViTinh.Models
@using QuanLyDonViTinh.Services
@inject KhoService KhoService
@inject IJSRuntime JSRuntime

<h3>Danh mục Kho</h3>

<EditForm Model="@khoDuocChon" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <InputNumber @bind-Value="khoDuocChon.Id" hidden />

    <div class="form-group">
        <label>Tên Kho:</label>
        <InputText @bind-Value="khoDuocChon.Ten_Kho" class="form-control" MaxLength="200" />
        <ValidationMessage For="@(() => khoDuocChon.Ten_Kho)" />
    </div>

    <div class="form-group">
        <label>Ghi chú:</label>
        <InputText @bind-Value="khoDuocChon.Ghi_Chu" class="form-control" MaxLength="500" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-2" style="color: red;">@errorMessage</div>
    }

    <button type="submit" class="btn btn-primary">
        @(khoDuocChon.Id == 0 ? "Thêm mới" : "Lưu thay đổi")
    </button>

    @if (khoDuocChon.Id != 0)
    {
        <button type="button" class="btn btn-secondary" @onclick="HuyBoSua">Hủy bỏ</button>
    }
</EditForm>

<hr />

<h4>Danh sách hiện có</h4>
@if (danhSachKho == null)
{
    <p><em>Đang tải dữ liệu...</em></p>
}
else
{
    <table class="table" border="1" style="border-collapse: collapse; width: 60%;">
        <thead>
            <tr>
                <th>Mã (ID)</th>
                <th>Tên Kho</th>
                <th>Ghi Chú</th>
                <th>Chức năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kho in danhSachKho)
            {
                <tr>
                    <td>@kho.Id</td>
                    <td>@kho.Ten_Kho</td>
                    <td>@kho.Ghi_Chu</td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => ChonDeSua(kho)">
                            Sửa
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => XoaKho(kho)">
                            Xóa
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<Kho> danhSachKho;
    private Kho khoDuocChon = new Kho();
    private string errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDanhSach();
    }

    private async Task LoadDanhSach()
    {
        danhSachKho = await KhoService.GetDanhSach();
        errorMessage = null;
    }

    private void ChonDeSua(Kho kho)
    {
        khoDuocChon = new Kho
            {
                // === SỬA === (Dùng "Id")
                Id = kho.Id,
                Ten_Kho = kho.Ten_Kho,
                Ghi_Chu = kho.Ghi_Chu
            };
        errorMessage = null;
    }

    private void HuyBoSua()
    {
        khoDuocChon = new Kho();
        errorMessage = null;
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            errorMessage = null;

            // === SỬA === (Kiểm tra "Id")
            if (khoDuocChon.Id == 0) // THÊM MỚI
            {
                await KhoService.AddKho(khoDuocChon);
            }
            else // CẬP NHẬT (SỬA)
            {
                await KhoService.UpdateKho(khoDuocChon);
            }

            await LoadDanhSach();
            HuyBoSua();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task XoaKho(Kho kho)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", new object[] { $"Bạn có chắc muốn xóa kho '{kho.Ten_Kho}' không?" });

        if (confirmed)
        {
            try
            {
                errorMessage = null;
                // === SỬA === (Truyền "Id" để xóa)
                await KhoService.DeleteKho(kho.Id);
                await LoadDanhSach();
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
        }
    }
}