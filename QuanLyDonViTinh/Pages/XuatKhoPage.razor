@page "/xuatkho"

@using QuanLyDonViTinh.Models
@using QuanLyDonViTinh.Services
@inject XuatKhoService XKService
@inject KhoService KhoService
@inject SanPhamService SPService
@inject IJSRuntime JSRuntime

<h3>Quản lý Phiếu Xuất Kho</h3>

@if (!isEditingDetails)
{
    <h4>@(currentPhieu.Header.Id == 0 ? "1. Thêm Phiếu Xuất Mới" : $"1. Hiệu chỉnh Phiếu: {currentPhieu.Header.So_Phieu_Xuat_Kho}")</h4>
    <div class="card p-3 mb-4 border @(currentPhieu.Header.Id == 0 ? "border-primary" : "border-info")">

        <EditForm Model="@currentPhieu.Header" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-md-3 form-group">
                    <label>Số Phiếu:</label>
                    <InputText @bind-Value="currentPhieu.Header.So_Phieu_Xuat_Kho" class="form-control" />
                    <ValidationMessage For="@(() => currentPhieu.Header.So_Phieu_Xuat_Kho)" style="color:red;" />
                </div>
                <div class="col-md-3 form-group">
                    <label>Kho Xuất:</label>
                    <InputSelect @bind-Value="currentPhieu.Header.Kho_ID" class="form-control">
                        <option value="0">-- Chọn Kho --</option>
                        @if (danhSachKho != null)
                        {
                            @foreach (var kho in danhSachKho)
                            {
                                <option value="@kho.Id">@kho.Ten_Kho</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => currentPhieu.Header.Kho_ID)" style="color:red;" />
                </div>
                <div class="col-md-3 form-group">
                    <label>Ngày Xuất:</label>
                    <InputDate @bind-Value="currentPhieu.Header.Ngay_Xuat_Kho" class="form-control" />
                    <ValidationMessage For="@(() => currentPhieu.Header.Ngay_Xuat_Kho)" />
                </div>
                <div class="col-md-3 form-group">
                    <label>Ghi Chú:</label>
                    <InputText @bind-Value="currentPhieu.Header.Ghi_Chu" class="form-control" />
                </div>
            </div>

            <hr />

            @if (currentPhieu.Header.Id == 0)
            {
                <h5>Chi tiết Sản Phẩm</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead class="thead-light">
                            <tr>
                                <th style="width: 40%">Tên Hàng</th>
                                <th style="width: 15%" class="text-right">SL</th>
                                <th style="width: 20%" class="text-right">Đơn giá</th>
                                <th style="width: 15%" class="text-right">Thành tiền</th>
                                <th style="width: 10%"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in currentPhieu.Details)
                            {
                                <tr>
                                    <td>@detail.Ten_San_Pham</td>
                                    <td class="text-right">@detail.SL_Xuat.ToString("N0")</td>
                                    <td class="text-right">@detail.Don_Gia_Xuat.ToString("N0")</td>
                                    <td class="text-right">@((detail.SL_Xuat * detail.Don_Gia_Xuat).ToString("N0"))</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveDetail(detail)">Xóa</button>
                                    </td>
                                </tr>
                            }
                            <tr>
                                <td>
                                    <InputSelect @bind-Value="newDetail.San_Pham_ID" class="form-control form-control-sm" @onchange="@(e => UpdateNewDetailName(e))">
                                        <option value="0">-- Chọn Sản Phẩm --</option>
                                        @if (danhSachSP != null)
                                        {
                                            @foreach (var sp in danhSachSP)
                                            {
                                                <option value="@sp.Id">@sp.Ten_San_Pham</option>
                                            }
                                        }
                                    </InputSelect>
                                    @if (showDetailError)
                                    {
                                        <span style="color: red; font-size: 0.8em;">@detailErrorMessage</span>
                                    }
                                </td>
                                <td>
                                    <InputNumber @bind-Value="newDetail.SL_Xuat" class="form-control form-control-sm text-right" placeholder="SL" />
                                </td>
                                <td>
                                    <InputNumber @bind-Value="newDetail.Don_Gia_Xuat" class="form-control form-control-sm text-right" placeholder="Đơn giá" />
                                </td>
                                <td class="text-right align-middle font-weight-bold">
                                    @((newDetail.SL_Xuat * newDetail.Don_Gia_Xuat).ToString("N0"))
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-success" @onclick="AddDetail">Thêm</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <h5>Chi tiết Sản Phẩm (Xem)</h5>
                <div class="alert alert-info p-2 mb-2">
                    <small>Để thêm/xóa/sửa sản phẩm, vui lòng nhấn nút <b>"Chuyển sang sửa Chi tiết"</b> bên dưới.</small>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-striped bg-white">
                        <thead class="thead-light">
                            <tr>
                                <th>Tên Hàng</th>
                                <th class="text-right">SL</th>
                                <th class="text-right">Đơn giá</th>
                                <th class="text-right">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in currentPhieu.Details)
                            {
                                <tr>
                                    <td>@detail.Ten_San_Pham</td>
                                    <td class="text-right">@detail.SL_Xuat.ToString("N0")</td>
                                    <td class="text-right">@detail.Don_Gia_Xuat.ToString("N0")</td>
                                    <td class="text-right">@((detail.SL_Xuat * detail.Don_Gia_Xuat).ToString("N0"))</td>
                                </tr>
                            }
                            <tr>
                                <td colspan="3" class="text-right font-weight-bold">Tổng cộng:</td>
                                <td class="text-right font-weight-bold">
                                    @currentPhieu.Details.Sum(d => d.SL_Xuat * d.Don_Gia_Xuat).ToString("N0")
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }

            @if (!string.IsNullOrEmpty(pageErrorMessage))
            {
                <div class="alert alert-danger" style="color: red;">@pageErrorMessage</div>
            }

            <button type="submit" class="btn @(currentPhieu.Header.Id == 0 ? "btn-primary" : "btn-success") mt-3">
                @(currentPhieu.Header.Id == 0 ? "Lưu Phiếu Xuất" : "Lưu Hiệu Chỉnh")
            </button>
            <button type="button" class="btn btn-secondary mt-3" @onclick="ResetForm">
                @(currentPhieu.Header.Id == 0 ? "Hủy bỏ" : "Hủy Hiệu Chỉnh")
            </button>

            @if (currentPhieu.Header.Id != 0)
            {
                <button type="button" class="btn btn-info mt-3" @onclick="ChuyenSangSuaChiTiet">Chuyển sang sửa Chi tiết</button>
            }
        </EditForm>
    </div>
}
else if (currentPhieu.Header.Id != 0 && isEditingDetails)
{
    <h4>Quản lý Chi tiết Phiếu: @currentPhieu.Header.So_Phieu_Xuat_Kho</h4>
    <div class="card p-3 mb-4 border border-warning">

        <div class="row mb-3">
            <div class="col-md-6"><b>Kho:</b> @danhSachKho?.FirstOrDefault(k => k.Id == currentPhieu.Header.Kho_ID)?.Ten_Kho</div>
            <div class="col-md-6"><b>Ngày:</b> @currentPhieu.Header.Ngay_Xuat_Kho.ToString("dd/MM/yyyy")</div>
        </div>
        <hr />

        <h5>Lưới Hiệu Chỉnh (@currentPhieu.Details.Count Chi tiết)</h5>
        @if (!string.IsNullOrEmpty(pageErrorMessage))
        {
            <div class="alert alert-danger" style="color: red;">@pageErrorMessage</div>
        }
        <div class="table-responsive">
            <table class="table table-sm table-bordered">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 40%">Tên Hàng</th>
                        <th style="width: 15%" class="text-right">Số lượng</th>
                        <th style="width: 15%" class="text-right">Đơn giá</th>
                        <th style="width: 15%" class="text-right">Trị giá</th>
                        <th style="width: 15%" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in currentPhieu.Details)
                    {
                        <tr>
                            <td><span>@detail.Ten_San_Pham</span></td>
                            <td class="text-right">
                                @if (detail.Id == detailDangSua?.Id)
                                {
                                    <InputNumber @bind-Value="detailDangSua.SL_Xuat" class="form-control form-control-sm text-right" />
                                }
                                else
                                {
                                    <span>@detail.SL_Xuat.ToString("N0")</span>
                                }
                            </td>
                            <td class="text-right">
                                @if (detail.Id == detailDangSua?.Id)
                                {
                                    <InputNumber @bind-Value="detailDangSua.Don_Gia_Xuat" class="form-control form-control-sm text-right" format="N0" />
                                }
                                else
                                {
                                    <span>@detail.Don_Gia_Xuat.ToString("N0")</span>
                                }
                            </td>
                            <td class="text-right">@((detail.SL_Xuat * detail.Don_Gia_Xuat).ToString("N0"))</td>
                            <td class="text-center">
                                @if (detail.Id == detailDangSua?.Id)
                                {
                                    <button class="btn btn-sm btn-success" @onclick="LuuSuaChiTiet">Lưu</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="HuySuaChiTiet">Hủy</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-warning" @onclick="() => ChonDeSuaChiTiet(detail)">Sửa</button>
                                    <button class="btn btn-sm btn-danger" @onclick="async () => await XoaChiTiet(detail)">Xóa</button>
                                }
                            </td>
                        </tr>
                    }
                    <tr>
                        <td>
                            <InputSelect @bind-Value="newDetail.San_Pham_ID" class="form-control form-control-sm" @onchange="@(e => UpdateNewDetailName(e))">
                                <option value="0">-- Thêm Sản Phẩm --</option>
                                @if (danhSachSP != null)
                                {
                                    @foreach (var sp in danhSachSP)
                                    {
                                        <option value="@sp.Id">@sp.Ten_San_Pham</option>
                                    }
                                }
                            </InputSelect>
                            @if (showDetailError)
                            {
                                <div class="text-danger small">@detailErrorMessage</div>
                            }
                        </td>
                        <td><InputNumber @bind-Value="newDetail.SL_Xuat" class="form-control form-control-sm text-right" placeholder="SL" /></td>
                        <td><InputNumber @bind-Value="newDetail.Don_Gia_Xuat" class="form-control form-control-sm text-right" placeholder="Đơn giá" /></td>
                        <td class="text-right font-weight-bold">@((newDetail.SL_Xuat * newDetail.Don_Gia_Xuat).ToString("N0"))</td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-success" @onclick="AddDetailTrongCheDoSua">Thêm</button></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <button type="button" class="btn btn-secondary mt-3" @onclick="QuayLaiQuanLyChung">Quay lại quản lý Phiếu</button>
    </div>
}

<hr />

<h4>2. Danh sách Phiếu Xuất Đã Lưu</h4>
@if (danhSachPhieu == null)
{
    <p><em>Đang tải dữ liệu...</em></p>
}
else
{
    <table class="table table-hover table-striped" border="1" style="border-collapse: collapse; width: 100%;">
        <thead>
            <tr>
                <th>Mã (ID)</th>
                <th>Số Phiếu</th>
                <th>Ngày Xuất</th>
                <th>Kho</th>
                <th class="text-right">Tổng Tiền</th>
                <th>Chức năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var phieu in danhSachPhieu)
            {
                <tr>
                    <td>@phieu.Id</td>
                    <td>@phieu.So_Phieu_Xuat_Kho</td>
                    <td>@phieu.Ngay_Xuat_Kho.ToString("dd/MM/yyyy")</td>
                    <td>@phieu.Ten_Kho</td>
                    <td class="text-right">@phieu.Tong_Tien.ToString("N0")</td>
                    <td>
                        <button class="btn btn-sm btn-info" @onclick="() => ChonPhieuDeSua(phieu.Id, false)">Sửa Header</button>
                        <button class="btn btn-sm btn-warning" @onclick="() => ChonPhieuDeSua(phieu.Id, true)">Chi tiết</button>
                        <a href="/inphieuxuat/@phieu.Id" target="_blank" class="btn btn-sm btn-success">
                            In Phiếu
                        </a>
                        <button class="btn btn-sm btn-danger" @onclick="async () => await DeletePhieuXuat(phieu)">Xóa</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}


@code {
    private bool isEditingDetails = false;
    private XuatKhoRawData detailDangSua;
    private IEnumerable<Kho> danhSachKho;
    private IEnumerable<SanPham> danhSachSP;
    private XuatKhoFull currentPhieu = new XuatKhoFull();
    private IEnumerable<XuatKho> danhSachPhieu;
    private string pageErrorMessage;
    private XuatKhoRawData newDetail = new XuatKhoRawData { SL_Xuat = 1, Don_Gia_Xuat = 0 };
    private bool showDetailError = false;
    private string detailErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        danhSachKho = await KhoService.GetDanhSach();
        danhSachSP = await SPService.GetDanhSach();
        await LoadDanhSachPhieu();
        ResetForm();
    }

    private async Task LoadDanhSachPhieu()
    {
        danhSachPhieu = await XKService.GetDanhSach();
        pageErrorMessage = null;
    }

    private async Task ChonPhieuDeSua(int id, bool editDetailMode)
    {
        pageErrorMessage = null;
        try
        {
            var header = await XKService.GetPhieuXuatById(id);
            var details = await XKService.GetChiTiet(id);
            if (header != null)
            {
                currentPhieu = new XuatKhoFull { Header = header, Details = details };
                isEditingDetails = editDetailMode;
                detailDangSua = null;
                StateHasChanged();
            }
        }
        catch (Exception ex) { pageErrorMessage = $"Lỗi tải phiếu: {ex.Message}"; }
    }

    private void ChuyenSangSuaChiTiet()
    {
        isEditingDetails = true;
        pageErrorMessage = null;
    }

    private void QuayLaiQuanLyChung()
    {
        isEditingDetails = false;
        detailDangSua = null;
        pageErrorMessage = null;
    }

    private void ChonDeSuaChiTiet(XuatKhoRawData detail)
    {
        detailDangSua = new XuatKhoRawData
            {
                Id = detail.Id,
                Xuat_Kho_ID = detail.Xuat_Kho_ID,
                San_Pham_ID = detail.San_Pham_ID,
                Ten_San_Pham = detail.Ten_San_Pham,
                SL_Xuat = detail.SL_Xuat,
                Don_Gia_Xuat = detail.Don_Gia_Xuat
            };
    }

    private async Task LuuSuaChiTiet()
    {
        try
        {
            if (detailDangSua.SL_Xuat <= 0 || detailDangSua.Don_Gia_Xuat <= 0)
            {
                pageErrorMessage = "SL và Đơn giá phải lớn hơn 0.";
                return;
            }
            await XKService.UpdateChiTiet(detailDangSua);
            var index = currentPhieu.Details.FindIndex(d => d.Id == detailDangSua.Id);
            if (index != -1) { currentPhieu.Details[index] = detailDangSua; }
            detailDangSua = null;
            await LoadDanhSachPhieu();
        }
        catch (Exception ex) { pageErrorMessage = $"Lỗi lưu chi tiết: {ex.Message}"; }
    }

    private void HuySuaChiTiet()
    {
        detailDangSua = null;
        showDetailError = false;
    }

    private async Task XoaChiTiet(XuatKhoRawData detail)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", new object[] { $"Bạn có chắc muốn xóa sản phẩm '{detail.Ten_San_Pham}' khỏi phiếu này không?" });
        if (confirmed)
        {
            try
            {
                await XKService.DeleteChiTiet(detail.Id);
                currentPhieu.Details.Remove(detail);
                await LoadDanhSachPhieu();
            }
            catch (Exception ex) { pageErrorMessage = $"Lỗi xóa chi tiết: {ex.Message}"; }
        }
    }

    // === SỬA LỖI QUAN TRỌNG ===
    private async Task AddDetailTrongCheDoSua()
    {
        showDetailError = false;
        detailErrorMessage = null;
        if (newDetail.San_Pham_ID == 0) { detailErrorMessage = "Vui lòng chọn Sản phẩm."; showDetailError = true; return; }
        if (newDetail.SL_Xuat <= 0) { detailErrorMessage = "SL Xuất phải lớn hơn 0."; showDetailError = true; return; }
        if (newDetail.Don_Gia_Xuat <= 0) { detailErrorMessage = "Đơn giá phải lớn hơn 0."; showDetailError = true; return; }
        if (currentPhieu.Details.Any(d => d.San_Pham_ID == newDetail.San_Pham_ID)) { detailErrorMessage = "Sản phẩm này đã có trong chi tiết phiếu."; showDetailError = true; return; }

        try
        {
            newDetail.Xuat_Kho_ID = currentPhieu.Header.Id;
            await XKService.AddChiTiet(newDetail); // LƯU DB

            var updatedDetails = await XKService.GetChiTiet(currentPhieu.Header.Id);
            currentPhieu.Details = updatedDetails.ToList();

            newDetail = new XuatKhoRawData { SL_Xuat = 1, Don_Gia_Xuat = 0 };
            await LoadDanhSachPhieu();
        }
        catch (Exception ex) { pageErrorMessage = $"Lỗi thêm chi tiết: {ex.Message}"; }
    }

    private async Task HandleValidSubmit()
    {
        pageErrorMessage = null;
        try
        {
            if (currentPhieu.Header.Id == 0) // THÊM MỚI
            {
                if (currentPhieu.Details == null || !currentPhieu.Details.Any())
                {
                    pageErrorMessage = "Phiếu xuất phải có ít nhất một sản phẩm chi tiết.";
                    return;
                }
                await XKService.AddPhieuXuat(currentPhieu);
                await JSRuntime.InvokeVoidAsync("alert", $"Thêm Phiếu Xuất Kho {currentPhieu.Header.So_Phieu_Xuat_Kho} thành công!");
            }
            else // HIỆU CHỈNH HEADER
            {
                await XKService.UpdatePhieuXuat(currentPhieu.Header);
                await JSRuntime.InvokeVoidAsync("alert", $"Hiệu chỉnh Phiếu {currentPhieu.Header.So_Phieu_Xuat_Kho} thành công!");
            }
            await LoadDanhSachPhieu();
            ResetForm();
        }
        catch (Exception ex) { pageErrorMessage = $"Lỗi: {ex.Message}"; }
    }

    private void AddDetail()
    {
        showDetailError = false;
        detailErrorMessage = null;
        if (detailDangSua != null) { return; }

        if (newDetail.San_Pham_ID == 0) { detailErrorMessage = "Vui lòng chọn Sản phẩm."; showDetailError = true; return; }
        if (newDetail.SL_Xuat <= 0) { detailErrorMessage = "SL Xuất phải lớn hơn 0."; showDetailError = true; return; }
        if (newDetail.Don_Gia_Xuat <= 0) { detailErrorMessage = "Đơn giá phải lớn hơn 0."; showDetailError = true; return; }
        if (currentPhieu.Details.Any(d => d.San_Pham_ID == newDetail.San_Pham_ID)) { detailErrorMessage = "Sản phẩm này đã có trong chi tiết phiếu."; showDetailError = true; return; }

        newDetail.Ten_San_Pham = danhSachSP.FirstOrDefault(sp => sp.Id == newDetail.San_Pham_ID)?.Ten_San_Pham;
        newDetail.Xuat_Kho_ID = currentPhieu.Header.Id;
        currentPhieu.Details.Add(new XuatKhoRawData
            {
                San_Pham_ID = newDetail.San_Pham_ID,
                Ten_San_Pham = newDetail.Ten_San_Pham,
                SL_Xuat = newDetail.SL_Xuat,
                Don_Gia_Xuat = newDetail.Don_Gia_Xuat,
                Xuat_Kho_ID = newDetail.Xuat_Kho_ID
            });
        newDetail = new XuatKhoRawData { SL_Xuat = 1, Don_Gia_Xuat = 0 };
    }

    private void ResetForm()
    {
        currentPhieu = new XuatKhoFull();
        currentPhieu.Header.Ngay_Xuat_Kho = DateTime.Today;
        newDetail = new XuatKhoRawData { SL_Xuat = 1, Don_Gia_Xuat = 0 };
        pageErrorMessage = null;
        showDetailError = false;
        isEditingDetails = false;
        detailDangSua = null;
    }

    private async Task DeletePhieuXuat(XuatKho phieu)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", new object[] { $"Bạn có chắc muốn xóa phiếu '{phieu.So_Phieu_Xuat_Kho}' không? Thao tác này không thể hoàn tác." });
        if (confirmed)
        {
            try
            {
                await XKService.DeletePhieuXuat(phieu.Id);
                await LoadDanhSachPhieu();
                ResetForm();
            }
            catch (Exception ex) { pageErrorMessage = $"Lỗi khi xóa: {ex.Message}"; }
        }
    }

    private void UpdateNewDetailName(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selectedId))
        {
            newDetail.San_Pham_ID = selectedId;
            newDetail.Ten_San_Pham = danhSachSP.FirstOrDefault(sp => sp.Id == selectedId)?.Ten_San_Pham;
        }
    }

    private void RemoveDetail(XuatKhoRawData detail)
    {
        currentPhieu.Details.Remove(detail);
        pageErrorMessage = null;
    }
}