@page "/baocao/chitietnhap"

@using QuanLyDonViTinh.Models
@using QuanLyDonViTinh.Services
@inject NhapKhoService NKService

<h3>Báo cáo Chi tiết Hàng Nhập</h3>

<div class="card p-3 mb-4">
    <div class="row">
        <div class="col-md-4 form-group">
            <label>Từ Ngày:</label>
            <InputDate @bind-Value="tuNgay" class="form-control" />
        </div>
        <div class="col-md-4 form-group">
            <label>Đến Ngày:</label>
            <InputDate @bind-Value="denNgay" class="form-control" />
        </div>
        <div class="col-md-4 align-self-end">
            <button class="btn btn-primary" @onclick="LoadDataReport">Xem Báo cáo</button>
        </div>
    </div>
</div>

@if (reportData == null && isLoading)
{
    <p><em>Đang tải dữ liệu...</em></p>
}
else if (reportData == null && !isLoading)
{
    <p><em>Chưa có dữ liệu. Vui lòng chọn ngày và nhấn "Xem Báo cáo".</em></p>
}
else if (!reportData.Any())
{
    <p><em>Không tìm thấy dữ liệu cho khoảng ngày đã chọn.</em></p>
}
else
{
    <table class="table table-striped table-bordered" border="1" style="border-collapse: collapse; width: 100%;">
        <thead>
            <tr>
                <th>Ngày nhập</th>
                <th>Số phiếu nhập</th>
                <th>NCC</th>
                <th>Mã sản phẩm</th>
                <th>Tên sản phẩm</th>
                <th class="text-right">SL Nhập</th>
                <th class="text-right">Đơn giá</th>
                <th class="text-right">Trị giá</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in reportData)
            {
                <tr>
                    <td>@item.Ngay_Nhap_Kho.ToString("dd/MM/yyyy")</td>
                    <td>@item.So_Phieu_Nhap_Kho</td>
                    <td>@item.Ten_NCC</td>
                    <td>@item.Ma_San_Pham</td>
                    <td>@item.Ten_San_Pham</td>
                    <td class="text-right">@item.SL_Nhap.ToString("N2")</td>
                    <td class="text-right">@item.Don_Gia_Nhap.ToString("N0")</td>
                    <td class="text-right">@item.Tri_Gia.ToString("N0")</td>
                </tr>
            }
            <tr>
                <td colspan="7" class="text-right"><b>Tổng cộng:</b></td>
                <td class="text-right"><b>@reportData.Sum(item => item.Tri_Gia).ToString("N0")</b></td>
            </tr>
        </tbody>
    </table>
}

@code {
    private DateTime tuNgay = DateTime.Today.AddDays(-7);
    private DateTime denNgay = DateTime.Today;
    private IEnumerable<BaoCaoChiTietHangNhapViewModel> reportData;
    private bool isLoading = false;

    private async Task LoadDataReport()
    {
        isLoading = true;
        reportData = null;
        try
        {
            reportData = await NKService.GetBaoCaoChiTietHangNhap(tuNgay, denNgay);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi tải báo cáo: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}