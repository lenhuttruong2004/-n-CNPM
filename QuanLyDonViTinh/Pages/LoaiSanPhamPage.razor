@page "/loaisanpham"

@using QuanLyDonViTinh.Models
@using QuanLyDonViTinh.Services
@inject LoaiSanPhamService LSPService
@inject IJSRuntime JSRuntime

<h3>Danh mục Loại Sản Phẩm</h3>

<EditForm Model="@lspDuocChon" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <InputNumber @bind-Value="lspDuocChon.Id" hidden />

    <div class="form-group">
        <label>Mã Loại SP:</label>
        <InputText @bind-Value="lspDuocChon.Ma_LSP" class="form-control" MaxLength="50" />
        <ValidationMessage For="@(() => lspDuocChon.Ma_LSP)" />
    </div>

    <div class="form-group">
        <label>Tên Loại SP:</label>
        <InputText @bind-Value="lspDuocChon.Ten_LSP" class="form-control" MaxLength="200" />
        <ValidationMessage For="@(() => lspDuocChon.Ten_LSP)" />
    </div>

    <div class="form-group">
        <label>Ghi chú:</label>
        <InputText @bind-Value="lspDuocChon.Ghi_Chu" class="form-control" MaxLength="500" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" style="color: red;">@errorMessage</div>
    }

    <button type="submit" class="btn btn-primary">
        @(lspDuocChon.Id == 0 ? "Thêm mới" : "Lưu thay đổi")
    </button>

    @if (lspDuocChon.Id != 0)
    {
        <button type="button" class="btn btn-secondary" @onclick="HuyBoSua">Hủy bỏ</button>
    }
</EditForm>

<hr />

<h4>Danh sách hiện có</h4>
@if (danhSachLSP == null)
{
    <p><em>Đang tải dữ liệu...</em></p>
}
else
{
    <table class="table" border="1" style="border-collapse: collapse; width: 60%;">
        <thead>
            <tr>
                <th>Mã LSP</th>
                <th>Tên Loại SP</th>
                <th>Ghi Chú</th>
                <th>Chức năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lsp in danhSachLSP)
            {
                <tr>
                    <td>@lsp.Ma_LSP</td>
                    <td>@lsp.Ten_LSP</td>
                    <td>@lsp.Ghi_Chu</td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => ChonDeSua(lsp)">
                            Sửa
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => XoaLoaiSanPham(lsp)">
                            Xóa
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<LoaiSanPham> danhSachLSP;
    private LoaiSanPham lspDuocChon = new LoaiSanPham();
    private string errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDanhSach();
    }

    private async Task LoadDanhSach()
    {
        danhSachLSP = await LSPService.GetDanhSach();
        errorMessage = null;
    }

    private void ChonDeSua(LoaiSanPham lsp)
    {
        lspDuocChon = new LoaiSanPham
            {
                // === SỬA === (Dùng "Id" và "Ma_LSP")
                Id = lsp.Id,
                Ma_LSP = lsp.Ma_LSP,
                Ten_LSP = lsp.Ten_LSP,
                Ghi_Chu = lsp.Ghi_Chu
            };
        errorMessage = null;
    }

    private void HuyBoSua()
    {
        lspDuocChon = new LoaiSanPham();
        errorMessage = null;
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            // === SỬA === (Kiểm tra "Id")
            if (lspDuocChon.Id == 0)
            {
                await LSPService.AddLoaiSanPham(lspDuocChon);
            }
            else
            {
                await LSPService.UpdateLoaiSanPham(lspDuocChon);
            }

            await LoadDanhSach();
            HuyBoSua();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task XoaLoaiSanPham(LoaiSanPham lsp)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", new object[] { $"Bạn có chắc muốn xóa loại sản phẩm '{lsp.Ten_LSP}' không?" });

        if (confirmed)
        {
            try
            {
                // === SỬA === (Truyền "Id" để xóa)
                await LSPService.DeleteLoaiSanPham(lsp.Id);
                await LoadDanhSach(); // (Bạn có thể muốn kiểm tra lại tên hàm này, LoadDanhSach)

                // Sửa: LoadDanhSach (từ code gốc của bạn bị gõ nhầm)
                // await LoadDanhSach();


                // === SỬA === (So sánh "Id")
                if (lspDuocChon.Id == lsp.Id)
                {
                    HuyBoSua();
                }
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
        }
    }

    // === LƯU Ý ===
    // Trong hàm XoaLoaiSanPham, tôi thấy bạn gọi "LoadDanhCheck()".
    // Tôi nghĩ bạn gõ nhầm và đã sửa lại thành "LoadDanhSach()".
    // Nếu "LoadDanhCheck" là một hàm khác có tồn tại, bạn hãy sửa lại nhé.
    // (Tôi đã comment lại hàm LoadDanhSach() để bạn tự quyết định)
}