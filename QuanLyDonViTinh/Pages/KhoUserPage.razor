@page "/phanquyenkho"

@using QuanLyDonViTinh.Models
@using QuanLyDonViTinh.Services
@inject KhoUserService KUService
@inject KhoService KhoService
@inject IJSRuntime JSRuntime

<h3>Phân quyền Kho - User</h3>

<EditForm Model="@khoUserMoi" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <div class="form-group">
        <label>Mã Đăng Nhập (User):</label>
        <InputText @bind-Value="khoUserMoi.Ma_Dang_Nhap" class="form-control" />
        <ValidationMessage For="@(() => khoUserMoi.Ma_Dang_Nhap)" style="color:red; " />
    </div>

    <div class="form-group">
        <label>Kho được cấp quyền:</label>
        <InputSelect @bind-Value="khoUserMoi.Kho_ID" class="form-control">
            <option value="0">-- Chọn Kho --</option>
            @if (danhSachKho != null)
            {
                @foreach (var kho in danhSachKho)
                {
                    <option value="@kho.Id">@kho.Ten_Kho</option>
                }
            }
        </InputSelect>
        <ValidationMessage For="@(() => khoUserMoi.Kho_ID)" style="color:red;" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" style="color: red;">@errorMessage</div>
    }

    <button type="submit" class="btn btn-primary">
        Thêm Quyền
    </button>
</EditForm>

<hr />

<h4>Danh sách Phân quyền hiện có</h4>
@if (danhSachKhoUser == null)
{
    <p><em>Đang tải dữ liệu...</em></p>
}
else
{
    <table class="table" border="1" style="border-collapse: collapse; width: 60%;">
        <thead>
            <tr>
                <th>Mã Đăng Nhập</th>
                <th>Tên Kho</th>
                <th>Chức năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ku in danhSachKhoUser)
            {
                <tr>
                    <td>@ku.Ma_Dang_Nhap</td>
                    <td>@ku.Ten_Kho</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => XoaPhanQuyen(ku)">
                            Xóa Quyền
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<KhoUser> danhSachKhoUser;
    private IEnumerable<Kho> danhSachKho;
    private KhoUser khoUserMoi = new KhoUser();
    private string errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // (Phải đảm bảo KhoService.GetDanhSach() trả về danh sách có "Id")
        danhSachKho = await KhoService.GetDanhSach();
        await LoadDanhSach();
    }

    private async Task LoadDanhSach()
    {
        // (KUService.GetDanhSach() giờ đã trả về danh sách có "Id")
        danhSachKhoUser = await KUService.GetDanhSach();
        errorMessage = null;
    }

    private void ResetForm()
    {
        string tempMaDangNhap = khoUserMoi.Ma_Dang_Nhap;
        khoUserMoi = new KhoUser { Ma_Dang_Nhap = tempMaDangNhap };
        errorMessage = null;
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            // (Logic kiểm tra Kho_ID == 0 của bạn đã đúng)
            if (khoUserMoi.Kho_ID == 0)
            {
                errorMessage = "Vui lòng chọn Kho để phân quyền.";
                return;
            }

            await KUService.AddKhoUser(khoUserMoi);

            await LoadDanhSach();
            ResetForm();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task XoaPhanQuyen(KhoUser ku)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", new object[] { $"Bạn có chắc muốn xóa quyền của user '{ku.Ma_Dang_Nhap}' tại kho '{ku.Ten_Kho}' không?" });

        if (confirmed)
        {
            try
            {
                // === SỬA ===
                // Xóa bằng Khóa Chính "Id", không phải cặp (Ma_Dang_Nhap, Kho_ID)
                // (Vì "ku" giờ đã có "Id" từ hàm GetDanhSach())
                await KUService.DeleteKhoUser(ku.Id);
                await LoadDanhSach();
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
        }
    }
}