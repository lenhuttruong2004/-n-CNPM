@page "/inphieunhap/{MaNK:int}"
@layout BlankLayout
@inject NhapKhoService NKService
@inject KhoService KhoService
@inject NhaCungCapService NCCService
@inject IJSRuntime JSRuntime

@if (phieuIn != null)
{
    <div class="container print-container">
        <h3 class="text-center">PHIẾU NHẬP KHO</h3>
        <p class="text-center">Ngày @phieuIn.Header.Ngay_Nhap_Kho.Day tháng @phieuIn.Header.Ngay_Nhap_Kho.Month năm @phieuIn.Header.Ngay_Nhap_Kho.Year</p>
        <p class="text-center">Số: <strong>@phieuIn.Header.So_Phieu_Nhap_Kho</strong></p>

        <hr />

        <div class="row">
            <div class="col-8">
                <p><strong>Đơn vị cung cấp:</strong> @tenNCC</p>
                <p><strong>Theo hóa đơn số:</strong> ... (nếu có)</p>
            </div>
            <div class="col-4">
                <p><strong>Nhập tại kho:</strong> @tenKho</p>
                <p><strong>Địa điểm:</strong> ... (nếu có)</p>
            </div>
        </div>
        <p><strong>Ghi chú/Diễn giải:</strong> @phieuIn.Header.Ghi_Chu</p>

        <table class="table table-bordered table-sm mt-3">
            <thead class="thead-light">
                <tr>
                    <th>STT</th>
                    <th>Tên Sản Phẩm</th>
                    <th>ĐVT</th>
                    <th>Số Lượng</th>
                    <th>Đơn Giá</th>
                    <th>Thành Tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (phieuIn.Details != null)
                {
                    int stt = 0;
                    @foreach (var detail in phieuIn.Details)
                    {
                        stt++;
                        <tr>
                            <td>@stt</td>
                            <td>@detail.Ten_San_Pham</td>
                            <td>@detail.Ten_Don_Vi_Tinh</td>
                            <td class="text-right">@detail.SL_Nhap.ToString("N0")</td>
                            <td class="text-right">@detail.Don_Gia_Nhap.ToString("N0")</td>
                            <td class="text-right">@((detail.SL_Nhap * detail.Don_Gia_Nhap).ToString("N0"))</td>
                        </tr>
                    }
                }
                <tr style="font-weight: bold;">
                    <td colspan="5" class="text-right">TỔNG CỘNG:</td>
                    <td class="text-right">@tongTien.ToString("N0")</td>
                </tr>
            </tbody>
        </table>

        <p><strong>Tổng số tiền (viết bằng chữ):</strong> @VNCurrency.ToString(tongTien) đồng.</p>

        <div class="row mt-5 signature-section">
            <div class="col-4 text-center">
                <strong>Người lập phiếu</strong><br />
                <em>(Ký, họ tên)</em>
            </div>
            <div class="col-4 text-center">
                <strong>Người giao hàng</strong><br />
                <em>(Ký, họ tên)</em>
            </div>
            <div class="col-4 text-center">
                <strong>Thủ kho</strong><br />
                <em>(Ký, họ tên)</em>
            </div>
        </div>
    </div>
}
else
{
    <p><em>Đang tải dữ liệu phiếu in...</em></p>
}

@code {
    [Parameter]
    public int MaNK { get; set; }

    private NhapKhoFull phieuIn;
    private string tenKho;
    private string tenNCC;
    private decimal tongTien = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var header = await NKService.GetPhieuNhapById(MaNK);
            var details = await NKService.GetChiTietFull(MaNK); // Cần hàm mới lấy chi tiết đầy đủ

            if (header != null)
            {
                phieuIn = new NhapKhoFull { Header = header, Details = details };

                // Lấy tên Kho và NCC
                var kho = await KhoService.GetKhoById(header.Kho_ID);
                tenKho = kho?.Ten_Kho;

                var ncc = await NCCService.GetNhaCungCapById(header.NCC_ID);
                tenNCC = ncc?.Ten_NCC;

                // Tính tổng tiền
                tongTien = phieuIn.Details.Sum(d => d.SL_Nhap * d.Don_Gia_Nhap);
            }
        }
        catch (Exception ex)
        {
            // Xử lý lỗi
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && phieuIn != null)
        {
            // Tự động gọi cửa sổ in sau khi render xong
            await JSRuntime.InvokeVoidAsync("window.print");
        }
    }
}