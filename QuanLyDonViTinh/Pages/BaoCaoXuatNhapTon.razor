@page "/baocao/xuatnhapton"

@using QuanLyDonViTinh.Models
@using QuanLyDonViTinh.Services
@inject ReportService ReportService

<h3>Báo cáo Xuất Nhập Tồn</h3>

<div class="card p-3 mb-4">
    <div class="row">
        <div class="col-md-4 form-group">
            <label>Từ Ngày:</label>
            <InputDate @bind-Value="tuNgay" class="form-control" />
        </div>
        <div class="col-md-4 form-group">
            <label>Đến Ngày:</label>
            <InputDate @bind-Value="denNgay" class="form-control" />
        </div>
        <div class="col-md-4 align-self-end">
            <button class="btn btn-primary" @onclick="LoadDataReport">Xem Báo cáo</button>
        </div>
    </div>
</div>

@if (isLoading)
{
    <p><em>Đang tải dữ liệu...</em></p>
}
else if (reportData == null)
{
    <p><em>Chưa có dữ liệu. Vui lòng chọn ngày và nhấn "Xem Báo cáo".</em></p>
}
else if (!reportData.Any())
{
    <p><em>Không tìm thấy dữ liệu phát sinh hoặc tồn kho cho khoảng ngày đã chọn.</em></p>
}
else
{
    <table class="table table-striped table-bordered" style="width:100%;">
        <thead>
            <tr>
                <th>Mã sản phẩm</th>
                <th>Tên sản phẩm</th>
                <th class="text-right">SL Đầu Kỳ</th>
                <th class="text-right">SL Nhập</th>
                <th class="text-right">SL Xuất</th>
                <th class="text-right">SL Cuối Kỳ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in reportData)
            {
                <tr>
                    <td>@item.Ma_San_Pham</td>
                    <td>@item.Ten_San_Pham</td>
                    <td class="text-right">@item.SL_Dau_Ky.ToString("N2")</td>
                    <td class="text-right">@item.SL_Nhap.ToString("N2")</td>
                    <td class="text-right">@item.SL_Xuat.ToString("N2")</td>
                    <td class="text-right">@item.SL_Cuoi_Ky.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private DateTime tuNgay = DateTime.Today.AddDays(-30);
    private DateTime denNgay = DateTime.Today;

    private IEnumerable<BaoCaoXuatNhapTonViewModel> reportData;
    private bool isLoading = false;

    private async Task LoadDataReport()
    {
        isLoading = true;
        reportData = null;
        try
        {
            reportData = await ReportService.GetBaoCaoXuatNhapTon(tuNgay, denNgay);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi tải báo cáo XNT: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
